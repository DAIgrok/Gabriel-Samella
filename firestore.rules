rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isCoupleWorldId(worldId) {
      return worldId == 'gabriel-samella-1206';
    }

    function isValidCoupleWorld(data) {
      return data.keys().hasAll(['worldId', 'journeyStarted', 'coins', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'worldId',
          'journeyStarted',
          'coins',
          'treeWaterCount',
          'currentDailyIndex',
          'config',
          'treeState',
          'kitten',
          'lettersState',
          'achievementsState',
          'storeItemsState',
          'easterEggsState',
          'phrasesState',
          'chatMessages',
          'gameRecords',
          'customPhotos',
          'customSongs',
          'customQuizQuestions',
          'timeCapsules',
          'coupleGoals',
          'calendarEvents',
          'dailyWheelState',
          'dreamHouseState',
          'aquariumState',
          'seasonalState',
          'missionsState',
          'legacyResetBackup',
          'createdAt',
          'updatedAt'
        ])
        && data.worldId is string && data.worldId.size() <= 64 && data.worldId == 'gabriel-samella-1206'
        && data.journeyStarted is bool
        && data.coins is int && data.coins >= 0 && data.coins <= 500000
        && (!('treeWaterCount' in data) || (data.treeWaterCount is int && data.treeWaterCount >= 0 && data.treeWaterCount <= 500000))
        && (!('currentDailyIndex' in data) || (data.currentDailyIndex is int && data.currentDailyIndex >= 0 && data.currentDailyIndex <= 5000))
        && (!('config' in data) || (data.config is map && data.config.keys().size() <= 16))
        && (!('treeState' in data) || (data.treeState is map && data.treeState.keys().size() <= 24))
        && (!('kitten' in data) || (data.kitten is map && data.kitten.keys().size() <= 45))
        && (!('lettersState' in data) || (data.lettersState is map && data.lettersState.keys().size() <= 10))
        && (!('achievementsState' in data) || (data.achievementsState is map && data.achievementsState.keys().size() <= 60))
        && (!('storeItemsState' in data) || (data.storeItemsState is map && data.storeItemsState.keys().size() <= 160))
        && (!('easterEggsState' in data) || (data.easterEggsState is map && data.easterEggsState.keys().size() <= 30))
        && (!('phrasesState' in data) || (data.phrasesState is map && data.phrasesState.keys().size() <= 150))
        && (!('chatMessages' in data) || (data.chatMessages is list && data.chatMessages.size() <= 200))
        && (!('gameRecords' in data) || (data.gameRecords is map && data.gameRecords.keys().size() <= 40))
        && (!('customPhotos' in data) || (data.customPhotos is list && data.customPhotos.size() <= 60))
        && (!('customSongs' in data) || (data.customSongs is list && data.customSongs.size() <= 40))
        && (!('customQuizQuestions' in data) || (data.customQuizQuestions is list && data.customQuizQuestions.size() <= 100))
        && (!('timeCapsules' in data) || (data.timeCapsules is list && data.timeCapsules.size() <= 40))
        && (!('coupleGoals' in data) || (data.coupleGoals is list && data.coupleGoals.size() <= 100))
        && (!('calendarEvents' in data) || (data.calendarEvents is list && data.calendarEvents.size() <= 150))
        && (!('dailyWheelState' in data) || (data.dailyWheelState is map && data.dailyWheelState.keys().size() <= 10))
        && (!('dreamHouseState' in data) || (data.dreamHouseState is map && data.dreamHouseState.keys().size() <= 16))
        && (!('aquariumState' in data) || (data.aquariumState is map && data.aquariumState.keys().size() <= 16))
        && (!('seasonalState' in data) || (data.seasonalState is map && data.seasonalState.keys().size() <= 10))
        && (!('missionsState' in data) || (data.missionsState is map && data.missionsState.keys().size() <= 12))
        && (!('legacyResetBackup' in data) || (data.legacyResetBackup is map && data.legacyResetBackup.keys().size() <= 8));
    }

    function isValidSharedPhoto(data) {
      return data.keys().hasAll(['id', 'index', 'title', 'subtitle', 'date', 'url', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id',
          'index',
          'title',
          'subtitle',
          'date',
          'url',
          'localPath',
          'driveUrl',
          'driveFileId',
          'sourceType',
          'aspect',
          'isFavorite',
          'inHomeLoop',
          'caption',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.index is int && data.index >= 0 && data.index <= 10000
        && data.title is string && data.title.size() <= 160
        && data.subtitle is string && data.subtitle.size() <= 300
        && data.date is string && data.date.size() <= 80
        && data.url is string && data.url.size() > 0 && data.url.size() <= 750000
        && (!('localPath' in data) || (data.localPath is string && data.localPath.size() <= 300))
        && (!('driveUrl' in data) || (data.driveUrl is string && data.driveUrl.size() <= 500))
        && (!('driveFileId' in data) || (data.driveFileId is string && data.driveFileId.size() <= 128))
        && (!('sourceType' in data) || (data.sourceType is string && data.sourceType.size() <= 24))
        && (!('aspect' in data) || (data.aspect is string && data.aspect.size() <= 24))
        && (!('isFavorite' in data) || data.isFavorite is bool)
        && (!('inHomeLoop' in data) || data.inHomeLoop is bool)
        && (!('caption' in data) || (data.caption is string && data.caption.size() <= 400));
    }

    match /couple_worlds/{worldId} {
      // Never allow collection listing/scraping
      allow list: if false;

      // Single-document access for the couple's designated QR world without requiring login
      allow get: if isValidId(worldId) && isCoupleWorldId(worldId);

      allow create: if isValidId(worldId)
        && isCoupleWorldId(worldId)
        && isValidCoupleWorld(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(worldId)
        && isCoupleWorldId(worldId)
        && isValidCoupleWorld(incoming())
        && incoming().worldId == existing().worldId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'journeyStarted',
          'coins',
          'treeWaterCount',
          'currentDailyIndex',
          'config',
          'treeState',
          'kitten',
          'lettersState',
          'achievementsState',
          'storeItemsState',
          'easterEggsState',
          'phrasesState',
          'chatMessages',
          'gameRecords',
          'customPhotos',
          'customSongs',
          'customQuizQuestions',
          'timeCapsules',
          'coupleGoals',
          'calendarEvents',
          'dailyWheelState',
          'dreamHouseState',
          'aquariumState',
          'seasonalState',
          'missionsState',
          'legacyResetBackup',
          'updatedAt'
        ]);

      allow delete: if isValidId(worldId) && isCoupleWorldId(worldId);

      match /photos/{photoId} {
        allow list: if isValidId(worldId) && isCoupleWorldId(worldId);
        allow get: if isValidId(worldId) && isCoupleWorldId(worldId) && isValidId(photoId);

        allow create: if isValidId(worldId)
          && isCoupleWorldId(worldId)
          && isValidId(photoId)
          && isValidSharedPhoto(incoming())
          && incoming().id == photoId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(worldId)
          && isCoupleWorldId(worldId)
          && isValidId(photoId)
          && isValidSharedPhoto(incoming())
          && incoming().id == existing().id
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'index',
            'title',
            'subtitle',
            'date',
            'url',
            'localPath',
            'driveUrl',
            'driveFileId',
            'sourceType',
            'aspect',
            'isFavorite',
            'inHomeLoop',
            'caption',
            'updatedAt'
          ]);

        allow delete: if isValidId(worldId) && isCoupleWorldId(worldId) && isValidId(photoId);
      }
    }
  }
}
